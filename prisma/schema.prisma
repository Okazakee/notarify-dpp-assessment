generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ImageRole {
  COVER
  GALLERY
}

enum DocumentKind {
  MANUAL
  WARRANTY
  TECHNICAL_DATASHEET
}

enum AssetState {
  ACCEPTED
  QUARANTINED
  REJECTED
}

enum PassportVersionAssetRole {
  COMPANY_LOGO
  COVER_IMAGE
  GALLERY_IMAGE
  PRODUCT_DOCUMENT
  CERTIFICATION_PDF
}

enum ReviewStatus {
  APPROVED
  REJECTED
}

enum AnalyticsEventKind {
  QR_HIT
  VIEW
}

enum CountrySource {
  MOCK
  NOT_CAPTURED
}

model Company {
  id          String  @id @default(uuid()) @db.Uuid
  displayName String  @db.VarChar(160)
  logoAssetId String? @unique @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  logoAsset Asset? @relation("CompanyLogo", fields: [logoAssetId], references: [id], onDelete: Restrict)
  users     User[]
  products  Product[]
  assets    Asset[]
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  email           String   @db.VarChar(320)
  normalizedEmail String   @unique @db.VarChar(320)
  passwordHash    String   @db.VarChar(512)
  role            UserRole
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sessions         AuthSession[]
  uploadedAssets   Asset[]           @relation("AssetUploader")
  publishedVersions PassportVersion[] @relation("PassportVersionPublisher")
  reviews          PassportReview[]  @relation("PassportReviewReviewer")
  auditEvents      AuditEvent[]      @relation("AuditActor")

  @@index([companyId, active, role])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @db.Uuid
  digest       String    @unique @db.VarChar(128)
  expiresAt    DateTime  @db.Timestamptz(6)
  usedAt       DateTime? @db.Timestamptz(6)
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  session     AuthSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy  RefreshToken? @relation("RefreshSuccessor", fields: [replacedById], references: [id], onDelete: Restrict)
  predecessor RefreshToken? @relation("RefreshSuccessor")

  @@index([sessionId, expiresAt])
  @@index([expiresAt])
  @@unique([id, sessionId])
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  stableCode String    @unique @db.VarChar(64)
  name       String    @db.VarChar(160)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  products Product[]
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  categoryId     String?   @db.Uuid
  name           String?   @db.VarChar(240)
  sku            String?   @db.VarChar(128)
  serialNumber   String?   @db.VarChar(160)
  description    String?   @db.Text
  productionDate DateTime? @db.Date
  originCountry  String?   @db.VarChar(2)
  draftRevision  Int       @default(0)
  deletedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  materials      Material[]
  sustainability Sustainability?
  certifications Certification[]
  images         ProductImage[]
  documents      ProductDocument[]
  passport       Passport?

  @@unique([companyId, serialNumber])
  @@index([companyId, deletedAt, categoryId])
  @@index([companyId, deletedAt, productionDate])
  @@index([companyId, sku])
  @@index([categoryId, deletedAt])
  @@index([deletedAt])
}

model Material {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  name          String   @db.VarChar(160)
  percentage    Decimal  @db.Decimal(5, 2)
  originCountry String?  @db.VarChar(2)
  recyclable    Boolean?
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@index([productId])
}

model Sustainability {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @unique @db.Uuid
  carbonKgCo2e       Decimal? @db.Decimal(12, 3)
  waterLitres        Decimal? @db.Decimal(12, 3)
  recycledPercent    Decimal? @db.Decimal(5, 2)
  repairabilityScore Decimal? @db.Decimal(4, 2)
  recyclable         Boolean?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Certification {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @db.Uuid
  pdfAssetId       String?   @db.Uuid
  name             String?   @db.VarChar(240)
  issuingAuthority String?   @db.VarChar(240)
  issueDate        DateTime? @db.Date
  expirationDate   DateTime? @db.Date
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  product  Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  pdfAsset Asset?  @relation("CertificationPdf", fields: [pdfAssetId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([pdfAssetId])
}

model Asset {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @db.Uuid
  uploaderId   String     @db.Uuid
  detectedMime String     @db.VarChar(127)
  sizeBytes    BigInt     @db.BigInt
  sha256       String     @db.VarChar(64)
  originalName String     @db.VarChar(255)
  state        AssetState @default(ACCEPTED)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploader        User                 @relation("AssetUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  content         AssetContent?
  companyLogoFor  Company?             @relation("CompanyLogo")
  certificationPdfs Certification[]    @relation("CertificationPdf")
  productImages   ProductImage[]
  productDocuments ProductDocument[]
  passportVersionAssets PassportVersionAsset[]

  @@index([companyId, state, createdAt])
  @@index([companyId, sha256])
}

model AssetContent {
  assetId String @id @db.Uuid
  bytes   Bytes  @db.ByteA

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  assetId   String    @db.Uuid
  role      ImageRole
  position  Int       @default(0)
  altText   String?   @db.VarChar(240)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([productId, assetId])
  @@unique([productId, role, position])
  @@index([assetId])
}

model ProductDocument {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @db.Uuid
  assetId   String       @db.Uuid
  kind      DocumentKind
  title     String?      @db.VarChar(240)
  position  Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([productId, assetId])
  @@unique([productId, position])
  @@index([assetId])
}

model Passport {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @unique @db.Uuid
  publicUuid       String    @unique @db.Uuid
  currentVersionId String?   @unique @db.Uuid
  firstPublishedAt DateTime  @db.Timestamptz(6)
  withdrawnAt      DateTime? @db.Timestamptz(6)
  qrTargetUrl      String    @db.VarChar(2048)
  qrPngBytes       Bytes     @db.ByteA
  qrGeneratedAt    DateTime  @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  versions       PassportVersion[] @relation("PassportVersions")
  currentVersion PassportVersion?  @relation("PassportCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  analyticsEvents AnalyticsEvent[]
  analyticsDaily  AnalyticsDaily[]

  @@index([withdrawnAt])
  @@index([productId, withdrawnAt])
}

model PassportVersion {
  id                    String   @id @default(uuid()) @db.Uuid
  passportId            String   @db.Uuid
  versionNumber         Int
  sourceDraftRevision   Int
  snapshotSchemaVersion Int
  publicSnapshot        Json     @db.JsonB
  publishedById         String   @db.Uuid
  publishedAt           DateTime @default(now()) @db.Timestamptz(6)

  passport              Passport              @relation("PassportVersions", fields: [passportId], references: [id], onDelete: Restrict)
  currentFor            Passport?             @relation("PassportCurrentVersion")
  publishedBy           User                  @relation("PassportVersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  retainedAssets        PassportVersionAsset[]
  review                PassportReview?
  analyticsEvents       AnalyticsEvent[]

  @@unique([passportId, versionNumber])
  @@unique([passportId, sourceDraftRevision])
  @@unique([id, passportId])
  @@index([passportId, publishedAt])
  @@index([publishedById, publishedAt])
}

model PassportVersionAsset {
  versionId String                    @db.Uuid
  assetId   String                    @db.Uuid
  role      PassportVersionAssetRole
  createdAt DateTime                  @default(now()) @db.Timestamptz(6)

  version PassportVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  asset   Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([versionId, assetId])
  @@index([assetId])
}

model PassportReview {
  id         String       @id @default(uuid()) @db.Uuid
  versionId  String       @unique @db.Uuid
  reviewerId String       @db.Uuid
  status     ReviewStatus
  scope      String       @db.VarChar(1024)
  reviewedAt DateTime     @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)

  version  PassportVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  reviewer User            @relation("PassportReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId, reviewedAt])
}

model AnalyticsEvent {
  id            String             @id @default(uuid()) @db.Uuid
  passportId    String             @db.Uuid
  versionId     String?            @db.Uuid
  kind          AnalyticsEventKind
  eventKey      String?            @unique @db.Uuid
  occurredAt    DateTime           @default(now()) @db.Timestamptz(6)
  ipAddress     String?            @db.VarChar(45)
  browser       String?            @db.VarChar(128)
  operatingSystem String?          @db.VarChar(128)
  language      String?            @db.VarChar(35)
  country       String?            @db.VarChar(2)
  countrySource CountrySource      @default(NOT_CAPTURED)
  source        String?            @db.VarChar(64)
  metadata      Json?              @db.JsonB
  synthetic     Boolean            @default(false)

  passport Passport        @relation(fields: [passportId], references: [id], onDelete: Restrict)
  version  PassportVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([passportId, occurredAt])
  @@index([passportId, kind, occurredAt])
  @@index([kind, occurredAt])
  @@index([occurredAt])
}

model AnalyticsDaily {
  id         String             @id @default(uuid()) @db.Uuid
  passportId String             @db.Uuid
  dateUtc    DateTime           @db.Date
  kind       AnalyticsEventKind
  synthetic  Boolean            @default(false)
  count      Int
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(6)

  passport Passport @relation(fields: [passportId], references: [id], onDelete: Restrict)

  @@unique([passportId, dateUtc, kind, synthetic])
  @@index([dateUtc, kind, synthetic])
  @@index([passportId, dateUtc, synthetic])
}

model AuditEvent {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String?   @db.Uuid
  entityType  String    @db.VarChar(80)
  entityId    String    @db.Uuid
  action      String    @db.VarChar(120)
  requestId   String?   @db.VarChar(128)
  occurredAt  DateTime  @default(now()) @db.Timestamptz(6)
  safeMetadata Json?    @db.JsonB

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
}
