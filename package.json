{
  "name": "notarify-dpp-assessment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:format": "prisma format --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@node-rs/argon2": "2.2.1",
    "@playwright/test": "1.63.0",
    "dotenv": "18.0.1",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
