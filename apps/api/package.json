{
  "name": "@notarify/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd ../.. && prisma generate --config prisma7.config.ts && tsc -p apps/api/tsconfig.json",
    "typecheck": "cd ../.. && prisma generate --config prisma7.config.ts && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "cd ../.. && prisma generate --config prisma7.config.ts && NODE_OPTIONS=--experimental-vm-modules jest --config apps/api/jest.config.mjs --runInBand",
    "test:integration": "pnpm run test"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.0.4",
    "@node-rs/argon2": "2.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "jsqr": "1.4.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12"
  }
}
