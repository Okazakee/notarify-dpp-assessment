# Copy to .env and adjust for your environment. Never commit real credentials.

# PostgreSQL connection used by Prisma migrations, the seed script and the future API.
# Prisma 7 reaches PostgreSQL through the @prisma/adapter-pg driver adapter; DATABASE_URL
# is read by prisma7.config.ts, not by a datasource block in schema.prisma.
DATABASE_URL="postgresql://notarify:CHANGE_ME@localhost:5432/notarify_test?schema=public"

# Environment name; the API must refuse to start on unsafe configuration.
NODE_ENV="development"

# Exact browser origin allowed to call the API with credentials. Required in
# production; defaults to the Next.js port in development.
CORS_ORIGIN="http://localhost:3001"

# Origin baked into published QR target URLs (/q/{uuid}). Required in production;
# defaults to the Next.js port in development. Never derived from a request Host header.
PUBLIC_APP_ORIGIN="http://localhost:3001"
