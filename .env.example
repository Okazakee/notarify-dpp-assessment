# Environment contract for the Notarify DPP assessment.
#
# Copy this file to `.env` before starting anything:
#
#   cp .env.example .env
#
# Every value below is a LOCAL REVIEWER DEFAULT. They are deliberately simple so the
# application runs out of the box, and they are NOT production credentials. The section at
# the bottom lists exactly what must change for a real deployment.

# ---------------------------------------------------------------------------
# API — required
# ---------------------------------------------------------------------------

# PostgreSQL connection. Prisma 7 reaches PostgreSQL through the @prisma/adapter-pg driver
# adapter, so this is read by prisma7.config.ts rather than by a datasource block.
DATABASE_URL="postgresql://notarify:notarify_local_only@localhost:5432/notarify?schema=public"

# Signing secret for access tokens. Must be present and non-trivial or the API refuses to
# start. The local value is a placeholder: generate a real one for any deployment.
JWT_SECRET="local-development-secret-change-me"

# development | test | production. Outside development the API requires explicit CORS and
# public origins instead of falling back to localhost defaults.
NODE_ENV="development"

# Port the API listens on.
PORT="3000"

# ---------------------------------------------------------------------------
# API — origins
# ---------------------------------------------------------------------------

# The exact browser origin allowed to call the API with credentials. Never a wildcard.
CORS_ORIGIN="http://localhost:3001"

# The origin printed into QR targets and public Passport URLs. Never derived from a
# request Host header.
PUBLIC_APP_ORIGIN="http://localhost:3001"

# ---------------------------------------------------------------------------
# API — optional
# ---------------------------------------------------------------------------

# Access-token lifetime in seconds. Short values make refresh behaviour easy to observe.
ACCESS_TOKEN_TTL_SECONDS="900"

# Disposable Redis cache for immutable published content. Leave empty to disable caching
# entirely: the application is fully functional without Redis, and a cache outage always
# falls back to PostgreSQL.
REDIS_URL=""

# Cache entry lifetime in seconds. Validated 1–86400.
REDIS_CACHE_TTL_SECONDS="300"

# The country recorded on analytics events. This assessment deliberately mocks the country
# and records it as mocked; it is never inferred from IP, language or locale.
ANALYTICS_MOCK_COUNTRY="IT"

# Interactive Swagger UI at /docs. Enabled here for reviewer convenience; a real
# deployment should leave it false unless the documentation is deliberately protected.
SWAGGER_ENABLED="true"

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------

# Browser-visible API origin. This value is compiled into the browser bundle, so it must be
# reachable from the reviewer's browser.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Server-side API origin used by Next when it calls the API from inside a container. In
# Docker Compose the browser reaches the API at localhost:3000 while the web container
# reaches it at http://api:3000. Leave empty for native development and the server-side
# code falls back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=""

# ---------------------------------------------------------------------------
# Reviewer demo seed
# ---------------------------------------------------------------------------

# Passwords for the two seeded demo accounts. They are public demo values, not secrets.
# Change them (or unset them in a real deployment) before seeding anything real.
DEMO_ADMIN_PASSWORD="AdminDemoPassw0rd!"
DEMO_EDITOR_PASSWORD="EditorDemoPassw0rd!"

# ---------------------------------------------------------------------------
# What must change for a real deployment
# ---------------------------------------------------------------------------
#
# 1. DATABASE_URL       — a real database with a real password.
# 2. JWT_SECRET         — a long random value, unique per environment, stored as a secret.
# 3. NODE_ENV           — production.
# 4. CORS_ORIGIN        — the real web origin, for example https://dpp.example.com.
# 5. PUBLIC_APP_ORIGIN  — the same public web origin.
# 6. REDIS_URL          — a managed or dedicated Redis instance, or leave empty.
# 7. NEXT_PUBLIC_API_URL — the browser-visible API origin, for example
#                          https://api.dpp.example.com.
# 8. INTERNAL_API_URL   — the server-side API origin inside the deployment network.
# 9. SWAGGER_ENABLED    — false unless the documentation is deliberately protected.
# 10. DEMO_*_PASSWORD   — remove; production accounts are created through the Users screen.
#
# Cookies are scoped to the API's `/auth` path, so serving the API from its own origin or
# subdomain (as above) is simpler than proxying it below `/api` on the web origin.
